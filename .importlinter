[importlinter]
root_package = fleetsre
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:1]
name = SRE isolation
type = forbidden
source_modules =
    fleetsre.sre
forbidden_modules =
    google
    fleetsre.adapters
    fleetsre.mock

[importlinter:contract:2]
name = Tripwire purity
type = forbidden
source_modules =
    fleetsre.evaluator.tripwires
forbidden_modules =
    fleetsre.adapters
    fleetsre.mock
    socket
    httpx
    urllib
    google
